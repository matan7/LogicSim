<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless MCP server: the same simulator and tools as the Unity app, without a window. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>logicsim-mcp</AssemblyName>
    <RootNamespace>LogicSim.McpServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LogicSim.Core/LogicSim.Core.csproj" />
  </ItemGroup>
</Project>
